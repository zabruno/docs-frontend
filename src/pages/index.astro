---
// Homepage - Centro de Ayuda
import DocsLayout from '../layouts/DocsLayout.astro';
import { getArticles, getSections } from '../lib/api';

const articles = await getArticles();
const sections = await getSections();

// Articulos recientes para featured
const featuredArticles = articles.slice(0, 6);
---

<DocsLayout title="Centro de Ayuda - Foca Software">
  {/* Hero Section */}
  <section class="text-center mb-16">
    <h1 class="text-5xl font-bold mb-4 text-gray-900 dark:text-white">
      Centro de <span class="text-orange-600">Ayuda</span>
    </h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
      Encontrá respuestas a tus preguntas y aprende a usar nuestras herramientas
    </p>
  </section>

  {/* Search placeholder */}
  <div class="max-w-xl mx-auto mb-16">
    <div class="relative">
      <input
        type="search"
        placeholder="Buscar articulos..."
        class="w-full px-4 py-3 pl-12 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent"
      />
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  {/* Featured Articles */}
  {featuredArticles.length > 0 && (
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-gray-900 dark:text-white">
        Articulos populares
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        {featuredArticles.map(article => (
          <a
            href={`/${article.slug}`}
            class="block p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-orange-500 dark:hover:border-orange-500 hover:shadow-lg transition-all group"
          >
            <h3 class="text-lg font-medium text-gray-900 dark:text-white group-hover:text-orange-600 dark:group-hover:text-orange-400 mb-2">
              {article.title}
            </h3>
            {article.section && (
              <span class="text-sm text-gray-500 dark:text-gray-400">
                {article.section}
              </span>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Sections Grid */}
  <section>
    <h2 class="text-2xl font-semibold mb-6 text-gray-900 dark:text-white">
      Explorar por seccion
    </h2>
    <div class="grid gap-4 md:grid-cols-3">
      {sections.map(section => (
        <a
          href={`/section/${encodeURIComponent(section)}`}
          class="p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-orange-500 dark:hover:border-orange-500 hover:shadow-lg transition-all group"
        >
          <h3 class="text-lg font-medium text-gray-900 dark:text-white group-hover:text-orange-600 dark:group-hover:text-orange-400">
            {section}
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
            {articles.filter(a => a.section === section).length} articulos
          </p>
        </a>
      ))}
    </div>
  </section>
</DocsLayout>
