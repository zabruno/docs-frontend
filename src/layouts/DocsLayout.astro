---
// Layout de 3 columnas con soporte para view switching y mobile sidebar
import Layout from './Layout.astro';
import { getSections } from '../lib/api';

export interface Props {
  title: string;
  description?: string;
  error?: boolean;
  activeView?: string;
}

const { title, description, error = false, activeView = 'home' } = Astro.props;
const sections = await getSections();
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080/api';
---

<Layout title={title} description={description}>
  {/* Header with theme toggle and hamburger */}
  <header class="fixed top-0 right-0 left-0 lg:left-64 z-50 h-14 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800">
    <div class="flex items-center justify-end h-full pr-4 lg:pr-6">
      {/* Hamburger button - solo visible en mobile */}
      <button
        id="sidebar-toggle"
        class="hidden lg:hidden mr-auto p-2 -ml-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 active:scale-95 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors duration-150"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="sidebar"
      >
        <svg class="w-6 h-6 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {/* Right side: Theme toggle */}
      <button
        id="theme-toggle"
        class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 active:scale-95 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors duration-150"
        aria-label="Cambiar tema"
      >
        {/* Sun icon - visible in dark mode */}
        <svg class="hidden dark:block w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        {/* Moon icon - visible in light mode */}
        <svg class="block dark:hidden w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </header>

  {/* Mobile overlay - backdrop */}
  <div
    id="sidebar-overlay"
    class="fixed inset-0 bg-black/50 z-30 hidden"
    aria-hidden="true"
  ></div>

  {/* Left Sidebar - Fixed navigation + sections */}
  <aside
    id="sidebar"
    class="w-64 border-r border-gray-200 dark:border-gray-800 fixed h-screen overflow-y-auto bg-white dark:bg-gray-900 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out z-40"
    aria-hidden="false"
  >
    <div class="p-4">
      {/* Logo / Brand */}
      <a href="/" class="flex items-center gap-2 mb-6 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 rounded-lg">
        <span class="text-xl font-bold text-orange-600">Foca</span>
        <span class="text-gray-500 dark:text-gray-400">Docs</span>
      </a>

      {/* Fixed navigation links - client-side view switching */}
      <nav class="space-y-1 mb-6">
        <button
          data-view="home"
          class="nav-btn w-full text-left px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors duration-150"
        >
          Ayuda
        </button>
        <button
          data-view="novedades"
          class="nav-btn w-full text-left px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors duration-150"
        >
          Novedades
        </button>
        <button
          data-view="soporte"
          class="nav-btn w-full text-left px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors duration-150"
        >
          Soporte
        </button>
      </nav>

      {/* Separator */}
      <hr class="border-gray-200 dark:border-gray-700 mb-4" />

      {/* Dynamic sections */}
      <div class="space-y-1">
        <p class="px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
          Secciones
        </p>
        {sections.map(section => (
          <button
            data-section-id={section.id}
            data-view="section"
            class="section-nav-btn w-full text-left px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors duration-150"
          >
            {section.name}
          </button>
        ))}
      </div>
    </div>
  </aside>

  {/* Main Content Area */}
  <main class="flex-1 lg:ml-64">
    <div class="max-w-4xl mx-auto px-4 lg:px-8 py-12 pt-20 lg:pt-16">
      {/* Error state */}
      {error ? (
        <div class="text-center py-20">
          <h1 class="text-6xl font-bold text-orange-500 mb-4">404</h1>
          <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">
            Pagina no encontrada
          </p>
          <p class="text-gray-500 dark:text-gray-500 mb-8">
            El contenido que buscas no existe o fue movido.
          </p>
          <button
            data-view="home"
            class="px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 active:scale-95 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-colors duration-150"
          >
            Volver al inicio
          </button>
        </div>
      ) : (
        <div id="section-articles" class="view hidden space-y-4"></div>
      )}
      
      <slot view={activeView} />
    </div>
  </main>

  {/* Right Sidebar - Table of Contents */}
  <aside class="w-64 border-l border-gray-200 dark:border-gray-800 fixed right-0 h-screen overflow-y-auto bg-white dark:bg-gray-900 hidden lg:block">
    <div class="p-4">
      <slot name="toc" />
    </div>
  </aside>

  {/* Combined scripts for navigation and sidebar */}
  <script define:vars={{ API_URL }}>
    // ==================== DOM ELEMENTS ====================
    const sidebar = document.getElementById('sidebar');
    const toggle = document.getElementById('sidebar-toggle');
    const overlay = document.getElementById('sidebar-overlay');
    
    // ==================== SIDEBAR CONTROL ====================
    function openSidebar() {
      if (!sidebar || !toggle || !overlay) return;
      sidebar.classList.remove('-translate-x-full');
      sidebar.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      overlay.classList.remove('hidden');
      if (window.innerWidth < 1024) {
        document.body.style.overflow = 'hidden';
      }
    }
    
    function closeSidebar() {
      if (!sidebar || !toggle || !overlay) return;
      sidebar.classList.add('-translate-x-full');
      sidebar.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'false');
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
    }
    
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
    
    // ==================== VIEW SWITCHER ====================
    function initViewSwitcher() {
      const navBtns = document.querySelectorAll<HTMLButtonElement>('[data-view]:not(.section-nav-btn)');
      
      navBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const view = btn.dataset.view;
          
          // Hide all views
          document.querySelectorAll<HTMLElement>('.view').forEach(v => {
            v.classList.add('hidden');
          });
          
          // Show target view
          const targetView = document.getElementById(`view-${view}`);
          if (targetView) {
            targetView.classList.remove('hidden');
          }
          
          // Update active state
          navBtns.forEach(b => {
            b.classList.remove('bg-orange-100', 'dark:bg-orange-900/30', 'text-orange-600', 'dark:text-orange-400');
            b.classList.add('text-gray-700', 'dark:text-gray-300');
          });
          btn.classList.remove('text-gray-700', 'dark:text-gray-300');
          btn.classList.add('bg-orange-100', 'dark:bg-orange-900/30', 'text-orange-600', 'dark:text-orange-400');
          
          closeSidebar();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    }
    
    // ==================== SECTION NAVIGATION ====================
    function initSectionNav() {
      const sectionBtns = document.querySelectorAll<HTMLButtonElement>('.section-nav-btn');
      
      sectionBtns.forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const sectionId = btn.dataset.sectionId;
          if (!sectionId) return;
          
          closeSidebar();
          
          try {
            const res = await fetch(`${API_URL}/articles?sectionId=${sectionId}`);
            if (!res.ok) throw new Error('Failed to fetch');
            const articles = await res.json();
            
            const container = document.getElementById('section-articles');
            if (container) {
              document.querySelectorAll<HTMLElement>('.view').forEach(v => v.classList.add('hidden'));
              container.classList.remove('hidden');
              
              const listEl = container.querySelector('#section-articles-list');
              if (listEl && articles.length > 0) {
                listEl.innerHTML = articles.map(a => `
                  <a href="/${a.slug}" class="block p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-orange-500 dark:hover:border-orange-500 hover:shadow-md active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 transition-all duration-150 group">
                    <h2 class="text-xl font-medium text-gray-900 dark:text-white group-hover:text-orange-600 dark:group-hover:text-orange-400 mb-2">
                      ${escapeHtml(a.title)}
                    </h2>
                    ${a.tags && a.tags.length > 0 ? `
                      <div class="flex gap-2 mt-3">
                        ${a.tags.slice(0, 3).map(t => `
                          <span class="px-2 py-0.5 text-xs rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400">${escapeHtml(t.name)}</span>
                        `).join('')}
                      </div>
                    ` : ''}
                  </a>
                `).join('');
              } else if (listEl) {
                listEl.innerHTML = '<p class="text-center py-12 text-gray-500 dark:text-gray-400">No hay articulos en esta seccion.</p>';
              }
            }
          } catch (err) {
            console.error('Error loading section:', err);
          }
        });
      });
    }
    
    // ==================== THEME TOGGLE ====================
    function initThemeToggle() {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }
    
    // ==================== MOBILE SIDEBAR ====================
    function initMobileSidebar() {
      if (!toggle || !sidebar || !overlay) return;
      
      // Toggle button
      toggle.addEventListener('click', () => {
        if (sidebar.classList.contains('-translate-x-full')) {
          openSidebar();
        } else {
          closeSidebar();
        }
      });
      
      // Overlay click
      overlay.addEventListener('click', closeSidebar);
      
      // Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !sidebar.classList.contains('-translate-x-full')) {
          closeSidebar();
        }
      });
      
      // Desktop resize
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) {
          closeSidebar();
        }
      });
    }
    
    // ==================== INITIALIZE ALL ====================
    initViewSwitcher();
    initSectionNav();
    initThemeToggle();
    initMobileSidebar();
  </script>
</Layout>

<style>
  /* Article typography polish - improved readability */
  :global(.article-content h1) {
    @apply text-4xl font-bold tracking-tight mb-6 mt-0 text-gray-900 dark:text-white;
  }
  :global(.article-content h2) {
    @apply text-2xl font-bold mb-4 mt-8 pb-3 text-gray-900 dark:text-white;
    border-bottom: 1px solid theme('colors.gray.200');
  }
  :global(.dark .article-content h2) {
    border-bottom-color: theme('colors.gray.700');
  }
  :global(.article-content h3) {
    @apply text-lg font-semibold mb-2 mt-6 text-gray-900 dark:text-white;
  }
  :global(.article-content p) {
    @apply leading-7 mb-5 text-gray-700 dark:text-gray-300;
  }
  :global(.article-content > p:first-child) {
    @apply mt-0;
  }
  :global(.article-content a) {
    @apply text-orange-600 hover:text-orange-700 dark:text-orange-400 dark:hover:text-orange-300 underline underline-offset-4;
  }
  :global(.article-content img) {
    @apply rounded-xl my-8 max-w-full shadow-md;
  }
  :global(.article-content ul, .article-content ol) {
    @apply mb-6 pl-6 text-gray-700 dark:text-gray-300;
  }
  :global(.article-content li) {
    @apply mb-2 leading-relaxed;
  }
  :global(.article-content li::marker) {
    @apply text-orange-500;
  }
  :global(.article-content blockquote) {
    @apply border-l-4 border-orange-500 pl-5 pr-4 py-3 my-6 italic text-gray-600 dark:text-gray-400 rounded-r-lg;
    background-color: theme('colors.gray.50');
  }
  :global(.dark .article-content blockquote) {
    background-color: theme('colors.gray.800');
  }
  :global(.article-content code:not(pre code)) {
    @apply bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded text-sm font-mono text-orange-600 dark:text-orange-400;
  }
  :global(.article-content pre) {
    @apply bg-gray-900/90 text-gray-100 p-5 rounded-xl border border-gray-700/50 overflow-x-auto my-6 shadow-lg;
  }
  :global(.article-content pre code) {
    @apply bg-transparent p-0 text-inherit;
  }
  :global(.article-content table) {
    @apply w-full border-collapse my-6 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm;
    display: block;
    overflow-x: auto;
  }
  :global(.article-content th) {
    @apply bg-gray-50 dark:bg-gray-800 font-semibold text-left px-4 py-3 border-b border-gray-200 dark:border-gray-700;
  }
  :global(.article-content td) {
    @apply px-4 py-3 border-b border-gray-100 dark:border-gray-700;
  }
  :global(.article-content tr:last-child td) {
    @apply border-b-0;
  }
  :global(.article-content hr) {
    @apply my-8 border-gray-200 dark:border-gray-700;
  }
  :global(.article-content strong) {
    @apply font-semibold text-gray-900 dark:text-white;
  }
</style>
