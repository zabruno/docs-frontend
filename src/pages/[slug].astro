---
// Pagina de articulo individual
import DocsLayout from '../layouts/DocsLayout.astro';
import { getArticle } from '../lib/api';
import { parseMarkdown, extractHeadings } from '../lib/markdown';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

// Intentar obtener el articulo, marcar error si no existe
let article = null;
let notFound = false;

try {
  article = await getArticle(slug);
} catch (error) {
  notFound = true;
}

// Procesar markdown en el servidor solo si el articulo existe
let html = '';
let headings: { level: number; id: string; text: string }[] = [];

if (article) {
  html = await parseMarkdown(article.content);
  headings = extractHeadings(html);
}
---

<DocsLayout title={notFound ? "No encontrado" : article!.title} error={notFound}>
  {notFound ? (
    // El error se muestra en DocsLayout, este slot queda vacio
    <div></div>
  ) : (
    <article class="article-content">
      {/* Breadcrumb */}
      {article!.section && (
        <nav class="text-sm text-gray-500 dark:text-gray-400 mb-4">
          <button data-view="home" class="hover:text-orange-600 dark:hover:text-orange-400 cursor-pointer">
            Ayuda
          </button>
          <span class="mx-2">/</span>
          <a href={`/section/${encodeURIComponent(article!.section.name)}`} class="hover:text-orange-600 dark:hover:text-orange-400">
            {article!.section.name}
          </a>
        </nav>
      )}

      {/* Titulo */}
      <h1 class="text-4xl font-bold mb-6 text-gray-900 dark:text-white">
        {article!.title}
      </h1>

      {/* Tags */}
      {article!.tags && article!.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {article!.tags.map(tag => (
            <span class="px-2 py-1 text-xs rounded-full bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300">
              {tag.name}
            </span>
          ))}
        </div>
      )}

      {/* Contenido HTML - envuelto en contenedor prose */}
      <div class="prose-ayuda" set:html={html} />

      {/* Metadata */}
      <div class="mt-12 pt-6 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-500 dark:text-gray-400">
        Actualizado: {new Date(article!.updatedAt).toLocaleDateString('es-ES')}
      </div>
    </article>
  )}

  {/* Table of Contents slot */}
  <div slot="toc">
    {headings.length > 0 && (
      <nav class="toc">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">
          En esta pagina
        </p>
        <ul class="space-y-1">
          {headings.map(h => (
            <li class={`toc-item ${h.level === 2 ? 'pl-3' : h.level === 3 ? 'pl-6' : ''}`}>
              <a
                href={`#${h.id}`}
                data-heading={h.id}
                class="block py-1 text-sm text-gray-600 dark:text-gray-400 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {/* Scroll spy script */}
    <script>
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-heading]');
      
      if (tocLinks.length > 0) {
        const observer = new IntersectionObserver((entries) => {
          const visible = entries
            .filter(e => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (visible) {
            tocLinks.forEach(a => a.classList.remove('active', 'text-orange-600'));
            const activeLink = document.querySelector<HTMLAnchorElement>(`[data-heading="${visible.target.id}"]`);
            if (activeLink) {
              activeLink.classList.add('active', 'text-orange-600');
            }
          }
        }, { rootMargin: '-80px 0px -80% 0px' });

        tocLinks.forEach(link => {
          const el = document.getElementById(link.dataset.heading!);
          if (el) observer.observe(el);
        });
      }
    </script>
  </div>
</DocsLayout>

<style>
  .toc a.active {
    @apply text-orange-600 font-medium;
  }
</style>
