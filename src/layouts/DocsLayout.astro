---
// Layout de 3 columnas con soporte para view switching y mobile sidebar
import Layout from './Layout.astro';
import { getSections } from '../lib/api';

export interface Props {
  title: string;
  description?: string;
  error?: boolean;
  activeView?: string;
}

const { title, description, error = false, activeView = 'home' } = Astro.props;
const sections = await getSections();
---

<Layout title={title} description={description}>
  {/* Header with theme toggle and hamburger */}
  <header class="fixed top-0 right-0 left-0 lg:left-64 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800">
    <div class="flex items-center justify-between px-4 lg:px-6 py-3">
      {/* Hamburger button - solo visible en mobile */}
      <button
        id="sidebar-toggle"
        class="hidden lg:hidden p-2 -ml-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="sidebar"
      >
        <svg class="w-6 h-6 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {/* Spacer for alignment when hamburger is hidden */}
      <div class="lg:hidden w-10"></div>

      {/* Right side: Theme toggle */}
      <button
        id="theme-toggle"
        class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label="Cambiar tema"
      >
        {/* Sun icon - visible in dark mode */}
        <svg class="hidden dark:block w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        {/* Moon icon - visible in light mode */}
        <svg class="block dark:hidden w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </header>

  {/* Mobile overlay - backdrop */}
  <div
    id="sidebar-overlay"
    class="fixed inset-0 bg-black/50 z-30 hidden"
    aria-hidden="true"
  ></div>

  {/* Left Sidebar - Fixed navigation + sections */}
  <aside
    id="sidebar"
    class="w-64 border-r border-gray-200 dark:border-gray-800 fixed h-screen overflow-y-auto bg-white dark:bg-gray-900 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out z-40"
    aria-hidden="false"
  >
    <div class="p-4">
      {/* Logo / Brand */}
      <a href="/" class="flex items-center gap-2 mb-6">
        <span class="text-xl font-bold text-orange-600">Foca</span>
        <span class="text-gray-500 dark:text-gray-400">Docs</span>
      </a>

      {/* Fixed navigation links - client-side view switching */}
      <nav class="space-y-1 mb-6">
        <button
          data-view="home"
          class="nav-btn w-full text-left px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
          Ayuda
        </button>
        <button
          data-view="novedades"
          class="nav-btn w-full text-left px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
          Novedades
        </button>
        <button
          data-view="soporte"
          class="nav-btn w-full text-left px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
          Soporte
        </button>
      </nav>

      {/* Separator */}
      <hr class="border-gray-200 dark:border-gray-700 mb-4" />

      {/* Dynamic sections */}
      <div class="space-y-1">
        <p class="px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
          Secciones
        </p>
        {sections.map(section => (
          <a
            href={`/section/${encodeURIComponent(section)}`}
            class="block px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-orange-50 dark:hover:bg-orange-900/20 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
          >
            {section}
          </a>
        ))}
      </div>
    </div>
  </aside>

  {/* Main Content Area */}
  <main class="flex-1 lg:ml-64">
    <div class="max-w-4xl mx-auto px-4 lg:px-8 py-12 pt-16 lg:pt-12">
      {/* Error state */}
      {error ? (
        <div class="text-center py-20">
          <h1 class="text-6xl font-bold text-orange-500 mb-4">404</h1>
          <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">
            Pagina no encontrada
          </p>
          <p class="text-gray-500 dark:text-gray-500 mb-8">
            El contenido que buscas no existe o fue movido.
          </p>
          <button
            data-view="home"
            class="px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors"
          >
            Volver al inicio
          </button>
        </div>
      ) : (
        <slot view={activeView} />
      )}
    </div>
  </main>

  {/* Right Sidebar - Table of Contents */}
  <aside class="w-64 border-l border-gray-200 dark:border-gray-800 fixed right-0 h-screen overflow-y-auto bg-white dark:bg-gray-900 hidden lg:block">
    <div class="p-4">
      <slot name="toc" />
    </div>
  </aside>

  {/* View switching script - minimal vanilla JS */}
  <script>
    function initViewSwitcher() {
      const navBtns = document.querySelectorAll<HTMLButtonElement>('[data-view]');
      
      navBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const view = btn.dataset.view;
          
          // Ocultar todas las vistas
          document.querySelectorAll<HTMLElement>('.view').forEach(v => {
            v.classList.add('hidden');
          });
          
          // Mostrar la vista seleccionada
          const targetView = document.getElementById(`view-${view}`);
          if (targetView) {
            targetView.classList.remove('hidden');
          }
          
          // Actualizar estado activo en sidebar
          navBtns.forEach(b => {
            b.classList.remove('bg-orange-100', 'dark:bg-orange-900/30', 'text-orange-600', 'dark:text-orange-400');
            b.classList.add('text-gray-700', 'dark:text-gray-300');
          });
          btn.classList.remove('text-gray-700', 'dark:text-gray-300');
          btn.classList.add('bg-orange-100', 'dark:bg-orange-900/30', 'text-orange-600', 'dark:text-orange-400');
          
          // Scroll al inicio
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    }
    
    initViewSwitcher();
  </script>

  {/* Theme toggle script - isolated */}
  <script>
    function initThemeToggle() {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }
    
    initThemeToggle();
  </script>

  {/* Mobile sidebar script - isolated with guard */}
  <script>
    function initMobileSidebar() {
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      
      if (!toggle || !sidebar || !overlay) return;
      
      // Verificar si ya esta inicializado (evitar duplicados en navegacion)
      if (toggle.dataset.initialized) return;
      toggle.dataset.initialized = 'true';
      
      function openSidebar() {
        sidebar.classList.remove('-translate-x-full');
        sidebar.setAttribute('aria-hidden', 'false');
        toggle.setAttribute('aria-expanded', 'true');
        overlay.classList.remove('hidden');
        // Solo bloquear scroll en mobile
        if (window.innerWidth < 1024) {
          document.body.style.overflow = 'hidden';
        }
      }
      
      function closeSidebar() {
        sidebar.classList.add('-translate-x-full');
        sidebar.setAttribute('aria-hidden', 'false');
        toggle.setAttribute('aria-expanded', 'false');
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }
      
      toggle.addEventListener('click', () => {
        if (sidebar.classList.contains('-translate-x-full')) {
          openSidebar();
        } else {
          closeSidebar();
        }
      });
      
      overlay.addEventListener('click', closeSidebar);
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !sidebar.classList.contains('-translate-x-full')) {
          closeSidebar();
        }
      });
      
      // Cerrar sidebar al cambiar a desktop
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) {
          sidebar.classList.remove('-translate-x-full');
          sidebar.setAttribute('aria-hidden', 'false');
          overlay.classList.add('hidden');
          document.body.style.overflow = '';
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    }
    
    initMobileSidebar();
  </script>
</Layout>

<style>
  /* Estilos base para contenido de articulos */
  :global(.article-content h1) {
    @apply text-3xl font-bold mb-4 mt-8 text-gray-900 dark:text-white;
  }
  :global(.article-content h2) {
    @apply text-2xl font-semibold mb-3 mt-6 text-gray-900 dark:text-white;
  }
  :global(.article-content h3) {
    @apply text-xl font-medium mb-2 mt-4 text-gray-900 dark:text-white;
  }
  :global(.article-content p) {
    @apply mb-4 leading-relaxed text-gray-700 dark:text-gray-300;
  }
  :global(.article-content a) {
    @apply text-orange-600 hover:text-orange-700 dark:text-orange-400 dark:hover:text-orange-300 underline;
  }
  :global(.article-content img) {
    @apply rounded-lg my-6 max-w-full;
  }
  :global(.article-content ul, .article-content ol) {
    @apply mb-4 pl-6 text-gray-700 dark:text-gray-300;
  }
  :global(.article-content li) {
    @apply mb-2;
  }
  :global(.article-content blockquote) {
    @apply border-l-4 border-orange-500 pl-4 italic text-gray-600 dark:text-gray-400 my-4;
  }
  :global(.article-content code:not(pre code)) {
    @apply bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded text-sm font-mono text-orange-600 dark:text-orange-400;
  }
  :global(.article-content pre) {
    @apply bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto my-6;
  }
  :global(.article-content table) {
    @apply w-full border-collapse my-6;
  }
  :global(.article-content th, .article-content td) {
    @apply border border-gray-300 dark:border-gray-700 px-4 py-2 text-left;
  }
  :global(.article-content th) {
    @apply bg-gray-100 dark:bg-gray-800 font-semibold;
  }
</style>
